{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keytab",
  "identifier": "dev.keytab.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "keytab",
        "width": 640,
        "height": 120,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "HayzDev",
    "homepage": "https://github.com/HayzDev/keytab",
    "copyright": "Copyright (c) 2026 HayzDev. MIT License.",
    "category": "Utility",
    "shortDescription": "Keyboard-first Alt-Tab replacement",
    "longDescription": "Press Right Alt, type a window's letters, and that window gets focus.",
    "license": "MIT",
    "licenseFile": "LICENSE",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
