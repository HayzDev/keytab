{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keytab",
  "version": "0.1.0",
  "identifier": "dev.keytab.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "keytab",
        "width": 640,
        "height": 720,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ]
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"] }
}
